reference/

# Modeles haute definition : lourds, ils restent hors du depot.
public/models/*
!public/models/.gitkeep

# Materiaux HD produits depuis les donnees du joueur : derives du jeu, donc
# jamais dans le depot.
public/generated/

# Binaire d agrandissement telecharge, avec ses modeles : outil externe, pas
